{
 "doctype": "DocType",
 "name": "Lote de Pago",
 "module": "Cuentas por Pagar",
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "is_submittable": 1,
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "company",
  "fecha_pago",
  "naturaleza",
  "estado_lote",
  "col_lote",
  "secuencial",
  "concepto",
  "referencia_numerica",
  "cuenta_bancaria_empresa",
  "total_lote",
  "num_transferencias",
  "sec_transferencias",
  "transferencias",
  "sec_facturas",
  "facturas",
  "sec_archivo",
  "nombre_archivo",
  "archivo_tef",
  "generado_el",
  "autorizacion_banco",
  "transmitido_el",
  "lote_origen",
  "notas",
  "amended_from"
 ],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Serie", "options": "LOTE-.YYYY.-.####", "default": "LOTE-.YYYY.-.####", "hidden": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "Empresa", "options": "Company", "reqd": 1},
  {"fieldname": "fecha_pago", "fieldtype": "Date", "label": "Fecha de pago", "reqd": 1, "in_list_view": 1},
  {"fieldname": "naturaleza", "fieldtype": "Select", "label": "Naturaleza", "options": "\n06\n12", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "06 = Banamex a Banamex; 12 = interbancario SPEI"},
  {"fieldname": "estado_lote", "fieldtype": "Select", "label": "Estado del lote", "options": "Preparado\nAutorizado\nExportado\nTransmitido\nAplicado\nParcial\nRechazado\nCancelado", "default": "Preparado", "read_only": 1, "allow_on_submit": 1, "no_copy": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "col_lote", "fieldtype": "Column Break"},
  {"fieldname": "secuencial", "fieldtype": "Int", "label": "Secuencial del día", "read_only": 1, "allow_on_submit": 1, "no_copy": 1, "description": "Correlativo por fecha de pago entre las dos naturalezas (0001 a 0099); se asigna al generar el archivo y no se reutiliza, ni siquiera si el lote se cancela."},
  {"fieldname": "concepto", "fieldtype": "Data", "label": "Concepto en el archivo", "length": 20, "read_only": 1},
  {"fieldname": "referencia_numerica", "fieldtype": "Data", "label": "Referencia numérica", "length": 7, "read_only": 1},
  {"fieldname": "cuenta_bancaria_empresa", "fieldtype": "Link", "label": "Cuenta bancaria de cargo", "options": "Bank Account", "reqd": 1},
  {"fieldname": "total_lote", "fieldtype": "Currency", "label": "Total del lote", "options": "Company:company:default_currency", "read_only": 1, "in_list_view": 1},
  {"fieldname": "num_transferencias", "fieldtype": "Int", "label": "Transferencias", "read_only": 1},
  {"fieldname": "sec_transferencias", "fieldtype": "Section Break", "label": "Transferencias"},
  {"fieldname": "transferencias", "fieldtype": "Table", "label": "Transferencias", "options": "Lote de Pago Transferencia", "reqd": 1},
  {"fieldname": "sec_facturas", "fieldtype": "Section Break", "label": "Facturas"},
  {"fieldname": "facturas", "fieldtype": "Table", "label": "Facturas", "options": "Lote de Pago Factura", "reqd": 1},
  {"fieldname": "sec_archivo", "fieldtype": "Section Break", "label": "Archivo y banco"},
  {"fieldname": "nombre_archivo", "fieldtype": "Data", "label": "Nombre del archivo", "read_only": 1, "allow_on_submit": 1, "no_copy": 1},
  {"fieldname": "archivo_tef", "fieldtype": "Attach", "label": "Archivo TEF", "read_only": 1, "allow_on_submit": 1, "no_copy": 1},
  {"fieldname": "generado_el", "fieldtype": "Datetime", "label": "Generado el", "read_only": 1, "allow_on_submit": 1, "no_copy": 1},
  {"fieldname": "autorizacion_banco", "fieldtype": "Data", "label": "Autorización de BancaNet", "read_only": 1, "allow_on_submit": 1, "no_copy": 1, "description": "La captura el botón 'Marcar transmitido'; a mano no se edita."},
  {"fieldname": "transmitido_el", "fieldtype": "Datetime", "label": "Transmitido el", "read_only": 1, "allow_on_submit": 1, "no_copy": 1},
  {"fieldname": "lote_origen", "fieldtype": "Link", "label": "Reintento del lote", "options": "Lote de Pago", "read_only": 1, "no_copy": 1},
  {"fieldname": "notas", "fieldtype": "Small Text", "label": "Notas", "allow_on_submit": 1},
  {"fieldname": "amended_from", "fieldtype": "Link", "label": "Enmienda de", "options": "Lote de Pago", "read_only": 1, "no_copy": 1, "print_hide": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "email": 1, "report": 1, "export": 1, "share": 1, "select": 1},
  {"role": "CxP Tesoreria", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "email": 1, "report": 1, "export": 1, "select": 1},
  {"role": "CxP Revisor", "read": 1, "print": 1, "report": 1, "select": 1},
  {"role": "CxP Contabilidad", "read": 1, "print": 1, "report": 1, "export": 1, "select": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
