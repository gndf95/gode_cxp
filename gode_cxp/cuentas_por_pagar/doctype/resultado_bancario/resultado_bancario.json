{
 "doctype": "DocType",
 "name": "Resultado Bancario",
 "module": "Cuentas por Pagar",
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "lote",
  "naturaleza",
  "fecha_pago",
  "origen",
  "col_datos",
  "autorizacion",
  "estatus_archivo",
  "estado",
  "sec_movimientos",
  "movimientos",
  "sec_totales",
  "total_archivo",
  "total_calculado",
  "num_aplicados",
  "col_totales",
  "num_rechazados",
  "diferencias",
  "sec_archivo",
  "archivo",
  "aplicado_el",
  "aplicado_por"
 ],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Serie", "options": "RESB-.YYYY.-.####", "default": "RESB-.YYYY.-.####", "hidden": 1},
  {"fieldname": "lote", "fieldtype": "Link", "label": "Lote de pago", "options": "Lote de Pago", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "naturaleza", "fieldtype": "Data", "label": "Naturaleza", "fetch_from": "lote.naturaleza", "read_only": 1, "length": 2},
  {"fieldname": "fecha_pago", "fieldtype": "Date", "label": "Fecha de pago", "fetch_from": "lote.fecha_pago", "read_only": 1, "in_list_view": 1},
  {"fieldname": "origen", "fieldtype": "Select", "label": "Origen", "options": "Captura manual\nArchivo del portal", "default": "Captura manual", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "col_datos", "fieldtype": "Column Break"},
  {"fieldname": "autorizacion", "fieldtype": "Data", "label": "Autorización de BancaNet", "length": 12, "description": "La que devolvió el portal; por omisión, la que se capturó al transmitir el lote."},
  {"fieldname": "estatus_archivo", "fieldtype": "Data", "label": "Estatus del archivo", "length": 2, "description": "Lo que dijo el banco del archivo completo: 30 aplicado, 32 rechazado, 10 cancelado. Vacío en captura manual."},
  {"fieldname": "estado", "fieldtype": "Select", "label": "Estado", "options": "Importado\nAplicado\nCon diferencias\nRevisado", "default": "Importado", "read_only": 1, "no_copy": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "sec_movimientos", "fieldtype": "Section Break", "label": "Movimientos", "description": "Una línea por transferencia del lote: 3 = el banco la aplicó, 5 = la rechazó."},
  {"fieldname": "movimientos", "fieldtype": "Table", "label": "Movimientos", "options": "Resultado Bancario Movimiento", "reqd": 1},
  {"fieldname": "sec_totales", "fieldtype": "Section Break", "label": "Totales y diferencias"},
  {"fieldname": "total_archivo", "fieldtype": "Currency", "label": "Total del archivo", "description": "El total de control que trae el archivo del banco (todo lo que se le mandó)."},
  {"fieldname": "total_calculado", "fieldtype": "Currency", "label": "Total aplicado", "read_only": 1, "description": "Suma de los movimientos con estatus 3."},
  {"fieldname": "num_aplicados", "fieldtype": "Int", "label": "Aplicados", "read_only": 1},
  {"fieldname": "col_totales", "fieldtype": "Column Break"},
  {"fieldname": "num_rechazados", "fieldtype": "Int", "label": "Rechazados", "read_only": 1},
  {"fieldname": "diferencias", "fieldtype": "Small Text", "label": "Diferencias con el lote", "read_only": 1},
  {"fieldname": "sec_archivo", "fieldtype": "Section Break", "label": "Archivo y aplicación", "collapsible": 1},
  {"fieldname": "archivo", "fieldtype": "Attach", "label": "Archivo del banco", "read_only": 1, "no_copy": 1, "description": "Se sube con el botón 'Cargar archivo del portal' y queda como adjunto privado."},
  {"fieldname": "aplicado_el", "fieldtype": "Datetime", "label": "Aplicado el", "read_only": 1, "no_copy": 1},
  {"fieldname": "aplicado_por", "fieldtype": "Link", "label": "Aplicado por", "options": "User", "read_only": 1, "no_copy": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "email": 1, "report": 1, "export": 1, "share": 1, "select": 1},
  {"role": "CxP Tesoreria", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "report": 1, "export": 1, "select": 1},
  {"role": "CxP Revisor", "read": 1, "print": 1, "report": 1, "select": 1},
  {"role": "CxP Contabilidad", "read": 1, "print": 1, "report": 1, "export": 1, "select": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
