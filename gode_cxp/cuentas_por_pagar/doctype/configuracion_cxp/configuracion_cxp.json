{
 "doctype": "DocType",
 "name": "Configuracion CxP",
 "module": "Cuentas por Pagar",
 "issingle": 1,
 "custom": 0,
 "engine": "InnoDB",
 "editable_grid": 1,
 "track_changes": 1,
 "field_order": [
  "sec_empresa",
  "rfc_empresa",
  "empresa",
  "grupo_proveedores",
  "item_generico",
  "cuenta_gasto_default",
  "col_empresa",
  "cuenta_iva_acreditable",
  "cuenta_ieps",
  "cuenta_ret_iva",
  "cuenta_ret_isr",
  "dias_credito_default",
  "sec_pruebas",
  "modo_pruebas_correo",
  "sec_banco",
  "contrato_banamex",
  "cuenta_cargo_sucursal",
  "cuenta_cargo_numero",
  "cuenta_banco_erp",
  "cuenta_bancaria_empresa",
  "modo_pago_transferencia",
  "col_banco",
  "nombre_empresa_tef",
  "concepto_tef",
  "referencia_numerica_modo",
  "referencia_numerica_fija",
  "sec_preregistro",
  "exigir_preregistro",
  "importe_maximo_preregistro",
  "col_preregistro",
  "periodo_preregistro"
 ],
 "fields": [
  {"fieldname": "sec_empresa", "fieldtype": "Section Break", "label": "Empresa y contabilidad"},
  {"fieldname": "rfc_empresa", "fieldtype": "Data", "label": "RFC de la empresa (receptor de los CFDI)", "reqd": 1, "length": 13},
  {"fieldname": "empresa", "fieldtype": "Link", "label": "Empresa", "options": "Company", "reqd": 1},
  {"fieldname": "grupo_proveedores", "fieldtype": "Link", "label": "Grupo de proveedores para altas automáticas", "options": "Supplier Group"},
  {"fieldname": "item_generico", "fieldtype": "Link", "label": "Artículo genérico para conceptos CFDI", "options": "Item"},
  {"fieldname": "cuenta_gasto_default", "fieldtype": "Link", "label": "Cuenta de gasto por defecto", "options": "Account"},
  {"fieldname": "col_empresa", "fieldtype": "Column Break"},
  {"fieldname": "cuenta_iva_acreditable", "fieldtype": "Link", "label": "Cuenta IVA acreditable", "options": "Account"},
  {"fieldname": "cuenta_ieps", "fieldtype": "Link", "label": "Cuenta IEPS acreditable", "options": "Account"},
  {"fieldname": "cuenta_ret_iva", "fieldtype": "Link", "label": "Cuenta IVA retenido", "options": "Account"},
  {"fieldname": "cuenta_ret_isr", "fieldtype": "Link", "label": "Cuenta ISR retenido", "options": "Account"},
  {"fieldname": "dias_credito_default", "fieldtype": "Int", "label": "Días de crédito por defecto", "default": "30"},
  {"fieldname": "sec_pruebas", "fieldtype": "Section Break", "label": "Pruebas"},
  {"fieldname": "modo_pruebas_correo", "fieldtype": "Check", "label": "Modo pruebas: no enviar correos", "default": "0"},
  {"fieldname": "sec_banco", "fieldtype": "Section Break", "label": "Banco de cargo y archivo TEF"},
  {"fieldname": "contrato_banamex", "fieldtype": "Data", "label": "Contrato Banamex (12 dígitos)", "length": 12},
  {"fieldname": "cuenta_cargo_sucursal", "fieldtype": "Data", "label": "Sucursal de la cuenta de cargo (4 dígitos)", "length": 4},
  {"fieldname": "cuenta_cargo_numero", "fieldtype": "Data", "label": "Cuenta de cargo (7 dígitos)", "length": 7},
  {"fieldname": "cuenta_banco_erp", "fieldtype": "Link", "label": "Cuenta contable del banco de cargo", "options": "Account"},
  {"fieldname": "cuenta_bancaria_empresa", "fieldtype": "Link", "label": "Cuenta bancaria de la empresa", "options": "Bank Account"},
  {"fieldname": "modo_pago_transferencia", "fieldtype": "Link", "label": "Modo de pago de las transferencias", "options": "Mode of Payment", "default": "Transferencia bancaria"},
  {"fieldname": "col_banco", "fieldtype": "Column Break"},
  {"fieldname": "nombre_empresa_tef", "fieldtype": "Data", "label": "Nombre de la empresa en el archivo TEF (36)", "length": 36, "description": "Mayúsculas sin acentos ni puntos; es el ordenante que ve el banco."},
  {"fieldname": "concepto_tef", "fieldtype": "Data", "label": "Concepto del archivo TEF (20)", "length": 20},
  {"fieldname": "referencia_numerica_modo", "fieldtype": "Select", "label": "Referencia numérica", "options": "Fecha del lote\nFija", "default": "Fecha del lote"},
  {"fieldname": "referencia_numerica_fija", "fieldtype": "Data", "label": "Referencia numérica fija (7 dígitos)", "length": 7, "depends_on": "eval:doc.referencia_numerica_modo=='Fija'"},
  {"fieldname": "sec_preregistro", "fieldtype": "Section Break", "label": "Pre-registro de cuentas en BancaNet"},
  {"fieldname": "exigir_preregistro", "fieldtype": "Check", "label": "Exigir que la cuenta esté dada de alta en el banco", "default": "1", "description": "Banamex no deja pagar a una cuenta que no está pre-registrada. Apágalo sólo mientras se dan de alta los proveedores que ya existían."},
  {"fieldname": "importe_maximo_preregistro", "fieldtype": "Currency", "label": "Importe máximo por cuenta (pesos)", "default": "500000"},
  {"fieldname": "col_preregistro", "fieldtype": "Column Break"},
  {"fieldname": "periodo_preregistro", "fieldtype": "Select", "label": "Periodo del importe máximo", "options": "DIARIO\nSEMANAL\nQUINCENAL\nMENSUAL", "default": "DIARIO"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "print": 1, "email": 1, "share": 1},
  {"role": "CxP Tesoreria", "read": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
